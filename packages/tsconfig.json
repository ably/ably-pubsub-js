{
  "compilerOptions": {
    "target": "ES2017",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ably/pubsub-core": ["./core"],
      "@ably/pubsub-core/modular": ["./core/modular.d.ts"],
      "@ably/pubsub-core/liveobjects": ["./core/liveobjects.d.ts"],
      "@ably/pubsub-core/liveobjects/react": ["./core/react/cjs/liveobjects/index.d.ts"],
      "@ably/pubsub-core/react": ["./core/react/cjs/index.d.ts"],
      "@ably/pubsub-core/push": ["./core/push.d.ts"],
      "@ably/pubsub-core/react-native-push": ["./core/react-native-push.d.ts"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "device/src/**/*.ts",
    "device/**/*.d.ts",
    "device/**/*.d.mts",
    "server/src/**/*.ts",
    "server/**/*.d.ts",
    "server/**/*.d.mts"
  ]
}
