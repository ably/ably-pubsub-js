{
  "compilerOptions": {
    "target": "ES2017",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2017", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "ably": [".."],
      "ably/liveobjects": ["../liveobjects.d.ts"],
      "ably/react": ["../react/cjs/index.d.ts"],
      "ably/push": ["../push.d.ts"],
      "ably/react-native-push": ["../react-native-push.d.ts"]
    }
  },
  "include": ["shared/**/*.ts", "*/src/**/*.ts", "*/**/*.d.ts", "*/**/*.d.mts"]
}
