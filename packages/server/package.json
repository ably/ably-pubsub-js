{
  "name": "@ably/pubsub-server",
  "description": "Ably Pub/Sub client for servers: backend services and other trusted runtimes",
  "version": "2.30.0",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/node.js",
  "module": "./dist/index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "node": {
        "require": {
          "types": "./index.d.ts",
          "default": "./dist/node.js"
        },
        "import": {
          "types": "./index.d.mts",
          "default": "./dist/node.mjs"
        }
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./liveobjects": {
      "require": {
        "types": "./liveobjects/index.d.ts",
        "default": "./dist/liveobjects.js"
      },
      "import": {
        "types": "./liveobjects/index.d.mts",
        "default": "./dist/liveobjects.mjs"
      }
    },
    "./temporal": {
      "require": {
        "types": "./temporal/index.d.ts",
        "default": "./dist/temporal.js"
      },
      "import": {
        "types": "./temporal/index.d.mts",
        "default": "./dist/temporal.mjs"
      }
    },
    "./temporal/workflow": {
      "require": {
        "types": "./temporal/workflow/index.d.ts",
        "default": "./dist/temporal-workflow.js"
      },
      "import": {
        "types": "./temporal/workflow/index.d.mts",
        "default": "./dist/temporal-workflow.mjs"
      }
    }
  },
  "files": [
    "dist/**",
    "index.d.ts",
    "index.d.mts",
    "liveobjects/**",
    "temporal/**",
    "README.md"
  ],
  "dependencies": {
    "@ably/pubsub-core": "2.30.0",
    "dequal": "^2.0.3",
    "got": "^11.8.5",
    "ws": "^8.17.1"
  },
  "peerDependencies": {
    "@temporalio/activity": "1.x",
    "@temporalio/common": "1.x",
    "@temporalio/plugin": "1.x",
    "@temporalio/workflow": "1.x"
  },
  "peerDependenciesMeta": {
    "@temporalio/activity": {
      "optional": true
    },
    "@temporalio/common": {
      "optional": true
    },
    "@temporalio/plugin": {
      "optional": true
    },
    "@temporalio/workflow": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ably/ably-js.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/ably/ably-js/issues",
    "email": "support@ably.com"
  },
  "homepage": "https://github.com/ably/ably-js/tree/main/packages/server#readme",
  "keywords": [
    "ably",
    "realtime",
    "pubsub",
    "websockets",
    "server"
  ],
  "engines": {
    "node": ">=22"
  }
}
