{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ably/pubsub-core": ["./core"],
      "@ably/pubsub-core/api": ["./core/api.d.ts"],
      "@ably/pubsub-core/types": ["./core/types.d.ts"],
      "@ably/pubsub-core/modular": ["./core/modular.d.ts"],
      "@ably/pubsub-core/liveobjects": ["./core/liveobjects.d.ts"],
      "@ably/pubsub-core/liveobjects-types": ["./core/liveobjects-types.d.ts"],
      "@ably/pubsub-core/push": ["./core/push.d.ts"],
      "@ably/pubsub-core/react-native-push": ["./core/react-native-push.d.ts"]
    }
  },
  "include": [
    "core-impl/side/**/*.ts",
    "device/src/**/*.ts",
    "device/**/*.d.ts",
    "device/**/*.d.mts",
    "server/src/**/*.ts",
    "server/**/*.d.ts",
    "server/**/*.d.mts"
  ],
  // The Temporal plugin's entry points are type-checked by the plugin's own tsconfig instead
  // (`npm run build:temporal:types` and `npm run typecheck:temporal`). Checking them here, with
  // `skipLibCheck` off, would also check the Temporal SDK's declarations, which need a newer
  // TypeScript and @types/node than this repository uses.
  "exclude": ["server/src/temporal.ts", "server/src/temporal-workflow.ts", "server/temporal", "server/dist"]
}
