{
  // A program of its own, separate from src/, because the declarations src/ loads would hide what
  // this checks: the React hooks' declarations import the '@ably/pubsub-core' root, and once the
  // root is part of a program, an augmentation of it reaches the channel interfaces anyway. Do not
  // import '@ably/pubsub-core' or any React entry point from here.
  "include": ["*.ts"],
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler"
  }
}
